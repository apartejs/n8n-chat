{
    "name": "@aparte/n8n-chat",
    "version": "0.3.0",
    "homepage": "https://github.com/apartejs/n8n-chat#readme",
    "description": "n8n's chat widget, drawn by aparté: createChat() takes @n8n/chat's options — a button in the corner or a full-page chat on your Chat Trigger, response nodes and buttons included, in n8n's look, in ten languages, from npm or a CDN.",
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./style.css": {
            "default": "./dist/style.css"
        },
        "./theme.css": {
            "default": "./dist/theme.css"
        },
        "./cdn": {
            "default": "./dist/cdn/n8n-chat.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly && node scripts/build-css.mjs && node scripts/build-cdn.mjs",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@aparte/core": "0.29.3",
        "@aparte/locales": "0.29.3",
        "@aparte/plugin-cards": "0.29.3",
        "@aparte/plugin-marked": "0.29.3",
        "@aparte/plugin-shiki": "0.29.3",
        "@aparte/runner-n8n": "0.29.3",
        "@shikijs/langs": "4.5.0",
        "@shikijs/themes": "4.5.0",
        "marked": "18.0.6",
        "shiki": "4.5.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "esbuild": "0.25.12",
        "jsdom": "~22.1.0",
        "typescript": "~5.7.0",
        "vite": "^6.0.0",
        "vitest": "^2.1.0"
    },
    "keywords": [
        "ai",
        "n8n",
        "n8n-chat",
        "chat-widget",
        "chatbot",
        "chat-trigger",
        "web-components",
        "widget"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apartejs/n8n-chat.git"
    },
    "bugs": {
        "url": "https://github.com/apartejs/n8n-chat/issues"
    }
}
